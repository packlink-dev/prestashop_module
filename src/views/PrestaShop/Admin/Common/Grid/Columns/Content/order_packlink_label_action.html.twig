{% if record.isLabelAvailable %}
    <a class="btn btn-default pl-label-button pl-label-download"
       href="#"
       title="{{ 'Download'|trans({}, 'Modules.Packlink.Admin') }}"
       data-order="{{ record.id_order }}"
       onclick="plDownloadLabelOnOrdersPage(this); return false;"
       {% if record.isLabelPrinted %}
       style="color: #c3c3c3"
       {% endif %}
    >
        <i class="material-icons">file_download</i>
        <span>{{ 'Download'|trans({}, 'Modules.Packlink.Admin') }}</span>
    </a>
    <a class="btn btn-default pl-label-button pl-label-print"
       href="#"
       title="{{ 'Print'|trans({}, 'Modules.Packlink.Admin') }}"
       data-order="{{ record.id_order }}"
       onclick="plPrintLabelOnOrdersPage(this); return false;"
       {% if record.isLabelPrinted %}
       style="color: #c3c3c3"
       {% endif %}
    >
        <i class="material-icons">print</i>
        <span>{{ 'Print'|trans({}, 'Modules.Packlink.Admin') }}</span>
    </a>
{% else %}
    <div class="pl-no-label">
        <span>-</span>
    </div>
{% endif %}
